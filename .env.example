# ── Required: database ────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Either the service-role key (simplest) …
SUPABASE_SERVICE_ROLE_KEY=
# … or the publishable key plus the app secret stored in private.app_config (see README).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_APP_SECRET=

# ── AI extraction ────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Live data sources ────────────────────────────────────────────────
SCRAPINGBEE_API_KEY=
TICKETMASTER_API_KEY=          # optional, free at developer.ticketmaster.com
BANDSINTOWN_APP_ID=            # optional
SEARCH_BATCH=10                # artists web-searched per run (favourites always included)
# LISTING_URLS=https://www.district.in/events/music-this-weekend-in-bengaluru,https://allevents.in/bangalore/concerts

# ── Gmail + Google Calendar (one OAuth client) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=          # openssl rand -base64 32
ALERT_EMAIL_TO=                # optional default recipient
# Fallback email without OAuth: a Gmail app password
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=

# ── Security ─────────────────────────────────────────────────────────
CRON_SECRET=                   # openssl rand -hex 32
APP_SIGNING_SECRET=            # openssl rand -hex 32
APP_URL=                       # e.g. https://early-bird.vercel.app (auto-detected on Vercel)
